# ============================================================
#  Puente · Variables de entorno
#  Copia este archivo como .env y completa los valores.
#  El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# ============================================================

# ─── Servidor ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Dominios externos que pueden llamar a la API (separados por coma).
# El frontend servido por el mismo backend no necesita estar aquí.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ─── Base de datos MySQL ────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=puente_app
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=puente
# En la nube (Aiven) la conexión exige cifrado TLS:
#   DB_SSL=true y pega el certificado CA del servicio en DB_SSL_CA
DB_SSL=false
DB_SSL_CA=
# Crea las tablas y los datos iniciales al arrancar si no existen
DB_AUTO_INIT=true

# ─── Autenticación JWT ──────────────────────────────────────
# Genera un secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pon_aqui_una_cadena_aleatoria_de_al_menos_32_caracteres
JWT_EXPIRES_IN=2h

# ─── Usuarios iniciales (solo se crean si no existen) ───────
SEED_ADMIN_NOMBRE=Administración Puente
SEED_ADMIN_CORREO=admin@puente.test
SEED_ADMIN_PASSWORD=
SEED_EDITOR_NOMBRE=Equipo editorial
SEED_EDITOR_CORREO=editora@puente.test
SEED_EDITOR_PASSWORD=
